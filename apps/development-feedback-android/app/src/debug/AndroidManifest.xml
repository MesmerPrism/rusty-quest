<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:name=".FeedbackApplication" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".FeedbackActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider android:name=".FeedbackOperatorProvider" android:authorities="${applicationId}.feedback-operator"
            android:exported="true" android:permission="android.permission.DUMP" />
    </application>
</manifest>
