{
  "$schema": "https://raw.githubusercontent.com/MesmerPrism/rusty-morphospace-work-environment/6b75d944614a8f863dd612c9b114d7c68f0862b0/schemas/project-spec-v2.schema.json",
  "schema": "rusty.morphospace.workflow.project_spec.v2",
  "project_id": "spatial-camera-panel",
  "revision": 9,
  "owner": "spatial-camera-panel-legacy-index",
  "purpose": "Provide an inert protocol-v2 index for the archived mixed Spatial Camera Panel integration workspace without authorizing new Camera, private-effect, or Strobe work.",
  "activation_model": {
    "default": "disabled",
    "unlisted_modules": "inert",
    "runtime_rule": "selected-lock-and-runtime-input"
  },
  "composition": {
    "selected_features": [],
    "denied_features": [
      "camera-hwb-projection",
      "private-effect-layer",
      "spatial-vr-strobe"
    ],
    "selected_modules": [],
    "denied_modules": [
      "camera-hwb-projection",
      "private-effect-layer",
      "spatial-vr-strobe"
    ],
    "allowed_permissions": [],
    "denied_permissions": [
      "android.permission.CAMERA",
      "horizonos.permission.HEADSET_CAMERA",
      "horizonos.permission.SPATIAL_CAMERA"
    ],
    "data_classes": [
      "public-historical-workflow-index"
    ]
  },
  "authority_map": [
    {
      "parameter": "legacy.integration-history",
      "owner": "spatial-camera-panel-legacy-index",
      "adapters": []
    }
  ],
  "repositories": [
    {
      "repo_id": "quest-repo",
      "role": "adapter",
      "path": "../../..",
      "allowed_paths": [
        "AGENTS.md",
        "README.md",
        "apps/spatial-camera-panel-android/README.md",
        "apps/spatial-camera-panel-android/legacy-workspaces/",
        "apps/spatial-camera-panel-android/morphospace/",
        "docs/",
        "tools/"
      ]
    }
  ],
  "modules": [],
  "non_scope": [
    "Authorizing new Camera, private-effect, Strobe, particle, hand, media, asset, room, or broker implementation work.",
    "Rewriting the archived v1 units, events, receipts, candidates, reviews, or conformance locks.",
    "Treating historical blockers as current project gates for another consumer.",
    "Selecting a runtime feature, permission, route, asset, shader, service, activity, marker, or package effect.",
    "Device serials, raw headset evidence, APKs, logs, captures, signing material, private repository identities, and private effect formulas."
  ],
  "validation_profiles": [
    {
      "profile_id": "workflow",
      "commands": [
        "pwsh -NoProfile -ExecutionPolicy Bypass -File <work-environment-root>/scripts/Test-WorkflowContracts.ps1 -WorkspaceRoot <repo-root>/apps/spatial-camera-panel-android/morphospace"
      ]
    },
    {
      "profile_id": "host",
      "commands": [
        "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/checks/Test-SpatialCameraPanelWorkflowStatic.ps1 -RepoRoot ."
      ]
    }
  ],
  "acceptance_profiles": [
    {
      "profile_id": "archive-integrity",
      "commands": [
        "Recompute the sorted path-and-SHA-256 fingerprint of legacy-workspaces/mixed-integration-v1 and compare it with legacy-archive.json."
      ]
    }
  ],
  "release_policy": {
    "versioning": "semver",
    "commit_policy": "Preserve the archived v1 workspace byte-for-byte and commit only additive index or integrity evidence changes.",
    "push_checkpoint": "integration-batch",
    "source_first": true,
    "planning_last": true,
    "force_push_allowed": false
  },
  "public_boundary": {
    "mode": "public",
    "private_overlay": "local/",
    "prohibited_evidence": [
      "device serials",
      "raw logs and captures",
      "APKs",
      "signing and pairing material",
      "private repository identities",
      "private effect formulas and payloads"
    ]
  }
}
