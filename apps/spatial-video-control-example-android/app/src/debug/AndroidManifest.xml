<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application>
        <provider
            android:name=".DebugShellControlProvider"
            android:authorities="${applicationId}.debug-local-control"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <service
            android:name=".ConnectionHubDebugSurfaceService"
            android:enabled="true"
            android:exported="true"
            android:foregroundServiceType="dataSync"
            android:permission="android.permission.DUMP"
            android:stopWithTask="false">
            <intent-filter>
                <action android:name="${applicationId}.action.START_CONNECTION_HUB_DEBUG_SURFACE" />
                <action android:name="${applicationId}.action.STOP_CONNECTION_HUB_DEBUG_SURFACE" />
            </intent-filter>
        </service>
    </application>
</manifest>
