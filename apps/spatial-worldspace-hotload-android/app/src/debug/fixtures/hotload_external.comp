#version 450
// Fresh-source developer example: arithmetic and a branch, same public output ABI.
layout(local_size_x=2) in;
layout(set=0,binding=0,std430) writeonly buffer Output {vec4 rows[];} outputData;
layout(push_constant) uniform Params {uvec4 identity;vec4 timing;} params;
void main(){
    uint i=gl_GlobalInvocationID.x;if(i>=2)return;
    uint r=i*4;float t=params.timing.x+float(i)*1.5707963;
    float side=i==0?-.45:.45;
    outputData.rows[r]=vec4(side+.065*sin(t),1.69+.045*cos(t*1.3),-1.2,.04);
    vec4 color=vec4(.15,.8,1,1);
    if(sin(t)>.0)color=vec4(1,.55,.12,1);
    outputData.rows[r+1]=color;
    outputData.rows[r+2]=vec4(0,0,1,1);
    outputData.rows[r+3]=vec4(0,0,1,1);
}
