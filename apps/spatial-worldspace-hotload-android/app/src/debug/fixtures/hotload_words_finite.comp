#version 450
// Stable public full-word probe. Only two fixed diagnostic records are written.
layout(local_size_x=2) in;
layout(set=0,binding=0,std430) writeonly buffer Output {vec4 rows[];} outputData;
layout(push_constant) uniform Params {uvec4 identity;vec4 timing;} params;
void main(){
    uint i=gl_GlobalInvocationID.x;if(i>=2)return;
    uint r=i*4;
    uint x=i==0?0xbe012345u:0x3e765432u;
    outputData.rows[r]=vec4(uintBitsToFloat(x),uintBitsToFloat(0x3fd9999au),uintBitsToFloat(0xbf99999au),.035);
    outputData.rows[r+1]=i==0?vec4(.15,.8,1,1):vec4(1,.55,.12,1);
    outputData.rows[r+2]=vec4(0,0,1,1);
    uint z=i==0?0xbe012345u:0x3f012345u;
    uint w=i==0?0x3e765432u:0xbf765432u;
    outputData.rows[r+3]=vec4(0,0,uintBitsToFloat(z),uintBitsToFloat(w));
}
