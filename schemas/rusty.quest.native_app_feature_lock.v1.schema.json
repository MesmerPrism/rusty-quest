{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rusty.quest.native_app_feature_lock.v1",
  "title": "Rusty Quest native app resolved feature lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "app_id",
    "resolver_version",
    "resolution_fingerprint",
    "app_spec_path",
    "app_spec_sha256",
    "selected_feature_ids",
    "denied_feature_ids",
    "feature_descriptors",
    "dependency_reasons",
    "panel_source_closure",
    "exclusive_groups",
    "android_manifest",
    "runtime_profile",
    "app_settings",
    "settings_hotload",
    "permission_pregrant",
    "build_inputs",
    "expected_markers",
    "validation_commands",
    "generated_outputs"
  ],
  "properties": {
    "schema": {
      "const": "rusty.quest.native_app_feature_lock.v1"
    },
    "app_id": {
      "type": "string"
    },
    "resolver_version": {
      "type": "string"
    },
    "resolution_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "app_spec_path": {
      "type": "string"
    },
    "app_spec_sha256": {
      "type": "string"
    },
    "selected_feature_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "denied_feature_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "feature_descriptors": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "dependency_reasons": {
      "type": "object"
    },
    "panel_source_closure": {
      "type": "object"
    },
    "exclusive_groups": {
      "type": "object"
    },
    "android_manifest": {
      "type": "object"
    },
    "runtime_profile": {
      "type": "object"
    },
    "app_settings": {
      "type": "object"
    },
    "settings_hotload": {
      "type": "object"
    },
    "permission_pregrant": {
      "type": "object"
    },
    "build_inputs": {
      "type": "object",
      "required": [
        "env",
        "assets",
        "shaders",
        "payloads",
        "private_particle_payload_linkage",
        "private_asset_closure"
      ],
      "properties": {
        "env": { "type": "array" },
        "assets": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "shaders": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "payloads": { "type": "array" },
        "private_particle_payload_linkage": { "type": "object" },
        "private_asset_closure": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "mode",
            "provider_id",
            "provider_manifest_sha256",
            "inventory_sha256",
            "asset_count",
            "assets"
          ],
          "properties": {
            "schema": { "const": "rusty.quest.native_app_private_asset_closure.v1" },
            "mode": { "enum": ["inactive", "linked-provider"] },
            "provider_id": { "type": "string" },
            "provider_manifest_sha256": { "type": "string" },
            "inventory_sha256": { "type": "string" },
            "asset_count": { "type": "integer", "minimum": 0, "maximum": 32 },
            "assets": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "asset_id",
                  "logical_destination",
                  "staged_object",
                  "source_sha256",
                  "source_bytes",
                  "media_type"
                ],
                "properties": {
                  "asset_id": { "type": "string", "minLength": 1 },
                  "logical_destination": { "type": "string", "minLength": 1 },
                  "staged_object": { "type": "string", "minLength": 1 },
                  "source_sha256": {
                    "type": "string",
                    "minLength": 64,
                    "maxLength": 64,
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "source_bytes": { "type": "integer", "minimum": 1 },
                  "media_type": { "type": "string", "minLength": 3 }
                }
              }
            }
          }
        }
      }
    },
    "expected_markers": {
      "type": "object"
    },
    "validation_commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "generated_outputs": {
      "type": "object"
    }
  }
}
