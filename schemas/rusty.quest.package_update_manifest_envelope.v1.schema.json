{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-quest/schemas/rusty.quest.package_update_manifest_envelope.v1.schema.json",
  "title": "Rusty Quest Package Update Manifest Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "key_id", "algorithm", "signature", "signed"],
  "properties": {
    "schema": {
      "const": "rusty.quest.package_update_manifest_envelope.v1"
    },
    "key_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,96}$"
    },
    "algorithm": {
      "const": "Ed25519"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    },
    "signed": {
      "$ref": "#/$defs/manifest"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "manifest_id",
        "sequence",
        "issued_at_ms",
        "expires_at_ms",
        "rollout_ring",
        "artifact"
      ],
      "properties": {
        "schema": {
          "const": "rusty.quest.package_update_manifest.v1"
        },
        "manifest_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,128}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "issued_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expires_at_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "rollout_ring": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,32}$"
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "package_name",
            "version_code",
            "version_name",
            "apk_url",
            "apk_sha256",
            "apk_size_bytes",
            "signer_sha256"
          ],
          "properties": {
            "package_name": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
              "maxLength": 255
            },
            "version_code": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "version_name": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,64}$"
            },
            "apk_url": {
              "type": "string",
              "format": "uri",
              "maxLength": 2048,
              "pattern": "^https://[^/?#@]+/[^#\\s]+$"
            },
            "apk_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "apk_size_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "signer_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    }
  }
}
