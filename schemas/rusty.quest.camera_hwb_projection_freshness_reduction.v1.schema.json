{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mesmerprism.com/schemas/rusty.quest.camera_hwb_projection_freshness_reduction.v1.schema.json",
  "title": "Rusty Quest camera HWB Raw Projection freshness reduction v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "result",
    "input_bytes",
    "input_sha256",
    "reducer_sha256",
    "capture_schema",
    "capture_complete",
    "input_log_count",
    "receipt_count",
    "launch_challenge",
    "layer_generation",
    "layer_switch_count",
    "run_generation",
    "session_generation",
    "cadence_authority",
    "first_current_present_ordinal",
    "last_current_present_ordinal",
    "present_separation",
    "minimum_present_separation",
    "chain_contiguous",
    "monotonic_fields_confirmed",
    "continuous_raw_projection",
    "camera_projection_visible",
    "camera_projection_moving_witness",
    "moving_witness_authority",
    "visibility_scope",
    "wearer_visible_claim",
    "denied_marker_count",
    "fatal_marker_count"
  ],
  "properties": {
    "schema": { "const": "rusty.quest.camera_hwb_projection_freshness_reduction.v1" },
    "result": { "const": "pass" },
    "input_bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
    "input_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "reducer_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "capture_schema": { "const": "rusty.quest.camera_hwb_projection_freshness_capture.v1" },
    "capture_complete": { "const": true },
    "input_log_count": { "const": 1 },
    "receipt_count": { "type": "integer", "minimum": 2 },
    "launch_challenge": { "type": "integer", "minimum": 1 },
    "layer_generation": { "type": "integer", "minimum": 1 },
    "layer_switch_count": { "const": 0 },
    "run_generation": { "type": "integer", "minimum": 1 },
    "session_generation": { "type": "integer", "minimum": 1 },
    "cadence_authority": {
      "enum": [
        "spatial-sdk-broker-retired-fence-complete",
        "vulkan-wsi-queue-present-returned"
      ]
    },
    "first_current_present_ordinal": { "type": "integer", "minimum": 1 },
    "last_current_present_ordinal": { "type": "integer", "minimum": 301 },
    "present_separation": { "type": "integer", "minimum": 300 },
    "minimum_present_separation": { "type": "integer", "minimum": 300 },
    "chain_contiguous": { "const": true },
    "monotonic_fields_confirmed": { "const": true },
    "continuous_raw_projection": { "const": true },
    "camera_projection_visible": { "const": true },
    "camera_projection_moving_witness": { "const": true },
    "moving_witness_authority": { "const": "app-owned-command-buffer-camera-draw" },
    "visibility_scope": { "const": "app-command-buffer-not-wearer-visible" },
    "wearer_visible_claim": { "const": false },
    "denied_marker_count": { "const": 0 },
    "fatal_marker_count": { "const": 0 }
  }
}
