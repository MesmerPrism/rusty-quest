{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mesmerprism.com/schemas/rusty.quest.camera_hwb_projection_freshness_capture_finalization.v1.schema.json",
  "title": "Rusty Quest camera HWB Raw Projection capture finalization v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "result",
    "qfm_manifest_schema",
    "qfm_diagnostic_contract",
    "qfm_manifest_relative_path",
    "qfm_manifest_bytes",
    "qfm_manifest_sha256",
    "qfm_log_relative_path",
    "qfm_log_bytes",
    "qfm_log_sha256",
    "finalized_log_relative_path",
    "finalized_log_bytes",
    "finalized_log_sha256",
    "finalizer_sha256",
    "capture_schema",
    "capture_complete",
    "log_count",
    "capture_boundary",
    "capture_boundary_count",
    "output_file_count",
    "expected_serial",
    "expected_package",
    "expected_apk_sha256",
    "current_user_uid",
    "current_package_process_ids",
    "host_launch_fence",
    "host_fence_created_at",
    "device_launch_fence_epoch",
    "effect_disposition",
    "dispatch_attempted",
    "component_observed_resumed",
    "installed_identity_continuous",
    "uid_continuous",
    "post_action_window_elapsed",
    "output_limit_reached",
    "capture_exited_early",
    "process_tree_cleanup_succeeded",
    "input_bundle_unchanged",
    "semantic_freshness_adjudicated",
    "wearer_visible_claim"
  ],
  "properties": {
    "schema": { "const": "rusty.quest.camera_hwb_projection_freshness_capture_finalization.v1" },
    "result": { "const": "pass" },
    "qfm_manifest_schema": { "const": "questionable.file_manager.apk_launch_diagnostic_manifest.v1" },
    "qfm_diagnostic_contract": { "const": "questionable.file_manager.apk_launch_diagnostic_bundle.v1" },
    "qfm_manifest_relative_path": { "const": "launch-diagnostic-manifest.json" },
    "qfm_manifest_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
    "qfm_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "qfm_log_relative_path": { "const": "logcat-uid-post-fence.txt" },
    "qfm_log_bytes": { "type": "integer", "minimum": 0, "maximum": 262144 },
    "qfm_log_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "finalized_log_relative_path": { "const": "camera-hwb-projection-freshness.logcat.txt" },
    "finalized_log_bytes": { "type": "integer", "minimum": 94, "maximum": 262239 },
    "finalized_log_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "finalizer_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "capture_schema": { "const": "rusty.quest.camera_hwb_projection_freshness_capture.v1" },
    "capture_complete": { "const": true },
    "log_count": { "const": 1 },
    "capture_boundary": { "const": "schema=rusty.quest.camera_hwb_projection_freshness_capture.v1 captureComplete=true logCount=1" },
    "capture_boundary_count": { "const": 1 },
    "output_file_count": { "const": 2 },
    "expected_serial": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" },
    "expected_package": { "type": "string", "minLength": 3, "maxLength": 255, "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$" },
    "expected_apk_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "current_user_uid": { "type": "integer", "minimum": 10000 },
    "current_package_process_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1 }
    },
    "host_launch_fence": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "host_fence_created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}\\+00:00$"
    },
    "device_launch_fence_epoch": { "type": "string", "pattern": "^[0-9]{10,}\\.[0-9]{1,9}$" },
    "effect_disposition": { "const": "completed" },
    "dispatch_attempted": { "const": true },
    "component_observed_resumed": { "const": true },
    "installed_identity_continuous": { "const": true },
    "uid_continuous": { "const": true },
    "post_action_window_elapsed": { "const": true },
    "output_limit_reached": { "const": false },
    "capture_exited_early": { "const": false },
    "process_tree_cleanup_succeeded": { "const": true },
    "input_bundle_unchanged": { "const": true },
    "semantic_freshness_adjudicated": { "const": false },
    "wearer_visible_claim": { "const": false }
  }
}
