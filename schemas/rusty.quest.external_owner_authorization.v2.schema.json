{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-quest/schemas/rusty.quest.external_owner_authorization.v2.schema.json",
  "title": "Rusty Quest external-owner authorization tuple transport v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "payload",
    "signature"
  ],
  "properties": {
    "schema": {
      "const": "rusty.quest.external_owner_authorization.v2"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "issuer_id",
        "key_id",
        "audit_id",
        "repository",
        "pull_request_number",
        "base",
        "head",
        "changed_artifacts",
        "protected_artifacts",
        "assessment_sha256",
        "request_sha256",
        "issued_at",
        "expires_at",
        "decision",
        "limitations"
      ],
      "properties": {
        "schema": {
          "const": "rusty.quest.external_owner_authorization_payload.tuples.v2"
        },
        "issuer_id": {
          "$ref": "#/$defs/id"
        },
        "key_id": {
          "$ref": "#/$defs/id"
        },
        "audit_id": {
          "$ref": "#/$defs/id"
        },
        "repository": {
          "const": "MesmerPrism/rusty-quest"
        },
        "pull_request_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "base": {
          "$ref": "#/$defs/gitIdentity"
        },
        "head": {
          "$ref": "#/$defs/gitIdentity"
        },
        "changed_artifacts": {
          "$ref": "#/$defs/artifacts"
        },
        "protected_artifacts": {
          "$ref": "#/$defs/artifacts"
        },
        "assessment_sha256": {
          "$ref": "#/$defs/hash"
        },
        "request_sha256": {
          "$ref": "#/$defs/hash"
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "decision": {
          "const": "authorize-static-assessment"
        },
        "limitations": {
          "const": [
            "candidate_code_executed=false",
            "execution_attested=false",
            "acceptance_authority=false",
            "publication_authority=false"
          ]
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "public_key_spki_sha256",
        "value_base64"
      ],
      "properties": {
        "algorithm": {
          "const": "RSA-PSS-SHA256"
        },
        "public_key_spki_sha256": {
          "$ref": "#/$defs/hash"
        },
        "value_base64": {
          "type": "string",
          "minLength": 128,
          "maxLength": 2048,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,127}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "objectId": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "gitIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "tree"
      ],
      "properties": {
        "commit": {
          "$ref": "#/$defs/objectId"
        },
        "tree": {
          "$ref": "#/$defs/objectId"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "artifact": {
      "oneOf": [
        {
          "type": "array",
          "prefixItems": [
            {
              "$ref": "#/$defs/path"
            },
            {
              "const": "present"
            },
            {
              "enum": [
                "100644",
                "100755"
              ]
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 16777216
            },
            {
              "$ref": "#/$defs/hash"
            }
          ],
          "items": false,
          "minItems": 5,
          "maxItems": 5
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "$ref": "#/$defs/path"
            },
            {
              "const": "absent"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      ]
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\\\\\u0000-\\u001f\\u007f:]+$"
    }
  }
}
