      "debug.rustyquest.native_renderer.simultaneous_hands_controllers.enabled": "true"
    },
    "clear_families": [
      "hand_adapter",
      "simultaneous_hands_controllers"
    ],
    "expected_render_modes": [
      "solid-black-hands-and-grafts"
    ]
  },
  "build_inputs": {
    "env": [],
    "assets": [],
    "shaders": []
  },
