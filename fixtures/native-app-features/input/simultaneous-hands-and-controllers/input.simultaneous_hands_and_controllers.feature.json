    "required": [
      "simultaneousHandsControllersSelected=true",
      "extensionName=XR_META_simultaneous_hands_and_controllers",
      "extensionRequested=true",
      "extensionEnabled=true",
      "systemSupported=true",
      "functionsResolved=true",
      "handAdapterApplied=true",
      "handsCannotSubstituteController=true"
    ],
    "forbidden": [
      "XR_META_detached_controllers",
      "detachedControllersRequested=true"
