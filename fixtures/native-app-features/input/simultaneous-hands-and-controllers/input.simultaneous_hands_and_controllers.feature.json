  "description": "Disabled-by-default native-renderer adapter for XR_META_simultaneous_hands_and_controllers with independently proven hand and controller readiness.",
  "provides": [
    "input.hand_tracking.concurrent",
    "input.controllers.concurrent"
  ],
  "depends_on": [
