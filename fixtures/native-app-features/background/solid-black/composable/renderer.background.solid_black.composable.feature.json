{
  "schema": "rusty.quest.native_app_feature.v1",
  "feature_id": "renderer.background.solid_black.composable",
  "module_path": "background/solid-black-composable",
  "module_kind": "background-route",
  "settings_surface": {
    "authority": "rusty.quest.native_app_settings.v1",
    "adapter": "runtime_profile"
  },
  "owner_lane": "rusty-quest",
  "status": "public-substrate",
  "description": "Explicit opaque black native world-scene background retaining the original disabled camera and processing policy.",
  "provides": [
    "render.background.solid_black"
  ],
  "depends_on": [
    "quest.native.openxr_vulkan_base"
  ],
  "incompatible_with": [
    "renderer.background.solid_black",
    "renderer.background.native_passthrough"
  ],
  "exclusive_groups": {
    "background": "solid-black"
  },
  "android_manifest": {
    "permissions": [],
    "uses_features": [],
    "activities": [],
    "services": [],
    "queries": []
  },
  "runtime_profile": {
    "set": {
      "debug.rustyquest.native_renderer.camera.output": "disabled",
      "debug.rustyquest.native_renderer.replay.visual_proof.enabled": "false",
      "debug.rustyquest.native_renderer.processing.layer": "blur"
    },
    "clear_families": [
      "camera",
      "passthrough_style",
      "processing"
    ],
    "expected_render_modes": [
      "native-worldspace-integration"
    ]
  },
  "build_inputs": {
    "env": [
      {
        "name": "RUSTY_QUEST_NATIVE_RENDERER_BACKGROUND_MODE",
        "value": "solid-black"
      }
    ],
    "assets": [],
    "shaders": []
  },
  "markers": {
    "required": [
      "solidBlackBackground=true"
    ],
    "forbidden": [
      "nativePassthroughRequested=true",
      "cameraProjectionPath=metadata-target-guide-texture"
    ]
  },
  "validation": {
    "quick": [],
    "standard": [],
    "device": []
  },
  "public_private_boundary": "Solid black background policy is public; private visuals must attach through a selected visual feature."
