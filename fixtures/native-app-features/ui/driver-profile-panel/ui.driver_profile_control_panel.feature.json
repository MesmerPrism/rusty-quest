{
  "schema": "rusty.quest.native_app_feature.v1",
  "feature_id": "ui.driver_profile_control_panel",
  "module_path": "ui/driver-profile-panel",
  "module_kind": "same-apk-panel-mode",
  "settings_surface": {
    "authority": "rusty.quest.native_app_settings.v1",
    "adapter": "runtime_profile"
  },
  "owner_lane": "rusty-quest",
  "status": "public-app-feature",
  "description": "Closed-world driver-profile control panel using the consuming renderer's private-particle request adapter.",
  "provides": ["ui.driver_profile_control_panel"],
  "depends_on": ["ui.same_apk_control_panel"],
  "incompatible_with": ["renderer.stimulus_volume"],
  "exclusive_groups": {},
  "android_manifest": {
    "permissions": [],
    "uses_features": [],
    "activities": [],
    "services": [],
    "queries": []
  },
  "runtime_profile": {
    "set": {
      "debug.rustyquest.native_renderer.control_panel.mode": "driver-profile-panel"
    },
    "clear_families": [],
    "expected_render_modes": []
  },
  "build_inputs": {"env": [], "assets": [], "shaders": []},
  "markers": {"required": ["panelActivity=ControlPanelActivity"], "forbidden": []},
  "validation": {"quick": [], "standard": [], "device": []},
  "panel_composition": {
    "schema": "rusty.quest.native_renderer.panel_composition.v1",
    "selected_module_id": "driver-profile-controls",
    "denied_module_ids": [
      "breath-composition-controls",
      "stimulus-volume"
    ],
    "modules": [
      {
        "module_id": "driver-profile-controls",
        "entry_class": "io.github.mesmerprism.rustyquest.native_renderer.DriverProfilePanelModule",
        "dependencies": ["private-particle-request-adapter"],
        "source_files": [
          "apps/native-renderer-android/panel-modules/driver-profile/src/main/java/io/github/mesmerprism/rustyquest/native_renderer/DriverProfilePanelModule.java"
        ]
      },
      {
        "module_id": "private-particle-request-adapter",
        "entry_class": "",
        "dependencies": [],
        "source_files": [
          "apps/native-renderer-android/panel-modules/private-particle/src/main/java/io/github/mesmerprism/rustyquest/native_renderer/PrivateParticlePanelController.java"
        ]
      }
    ]
  },
  "public_private_boundary": "The panel chooses generic profiles; private payload semantics and effective renderer state remain with consuming owners."
}
